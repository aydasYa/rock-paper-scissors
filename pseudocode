START
    CALL playGame

FUNCTION playGame
    INITIALIZE scores

    FUNCTION playRound(humanChoice, computerChoice)
        SET roundWinner TO CALL determineRoundWinner(
            humanChoice,
            computerChoice
        )
        UPDATE score for roundWinner
            IF roundWinner EQUALS "human"
                INCREMENT humanScore
            ELSE IF roundWinner EQUALS "computer"
                INCREMENT computerScore
            ELSE
                DO NOT CHANGE score
            END IF
            
        DISPLAY round result
    END FUNCTION

    REPEAT 5 ROUNDS
        GET humanChoice
        GET computerChoice
        CALL playRound(humanChoice, computerChoice)
    END REPEAT

    EVALUATE game winner
    DISPLAY game winner
END FUNCTION

FUNCTION determineRoundWinner(humanChoice, computerChoice)
    EVALUATE rules
    RETURN "human", "computer" OR "tie"
END FUNCTION